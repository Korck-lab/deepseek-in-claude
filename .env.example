# DeepSeek API key — create one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Xiaomi MiMo — optional second provider. Leave empty to keep the proxy
# DeepSeek-only. The base URL may carry the /anthropic suffix the Anthropic leg
# needs; the proxy strips it for model discovery.
XIOMIMIMO_API_KEY=
XIOMIMIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic

# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash,deepseek-v4-pro
# DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# XIOMIMIMO_ANTHROPIC_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
# PORT=8787
