{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "ask-matt": { "description": "Ask which skill fits the situation", "template": "Use the ask-matt skill. $ARGUMENTS" },
    "claude-handoff": { "description": "Hand off to a fresh background agent", "template": "Use the claude-handoff skill. $ARGUMENTS" },
    "code-review": { "description": "Review changes since a fixed point (standards + spec)", "template": "Use the code-review skill. $ARGUMENTS" },
    "codebase-design": { "description": "Design/deepen a module's interface", "template": "Use the codebase-design skill. $ARGUMENTS" },
    "diagnosing-bugs": { "description": "Diagnose hard bugs and performance regressions", "template": "Use the diagnosing-bugs skill. $ARGUMENTS" },
    "domain-modeling": { "description": "Pin down domain terminology / ubiquitous language", "template": "Use the domain-modeling skill. $ARGUMENTS" },
    "git-guardrails-claude-code": { "description": "Block dangerous git commands via hooks", "template": "Use the git-guardrails-claude-code skill. $ARGUMENTS" },
    "grill-me": { "description": "Relentless interview to sharpen a plan", "template": "Use the grill-me skill. $ARGUMENTS" },
    "grill-with-docs": { "description": "Interview plan + create ADRs and glossary", "template": "Use the grill-with-docs skill. $ARGUMENTS" },
    "grilling": { "description": "Grill me about a plan, decision, or idea", "template": "Use the grilling skill. $ARGUMENTS" },
    "handoff": { "description": "Compact conversation into handoff doc", "template": "Use the handoff skill. $ARGUMENTS" },
    "implement": { "description": "Implement work from a spec or tickets", "template": "Use the implement skill. $ARGUMENTS" },
    "improve-codebase-architecture": { "description": "Scan for deepening opportunities, HTML report", "template": "Use the improve-codebase-architecture skill. $ARGUMENTS" },
    "loop-me": { "description": "Grill me about workflow specs in this workspace", "template": "Use the loop-me skill. $ARGUMENTS" },
    "migrate-to-shoehorn": { "description": "Migrate test `as` assertions to shoehorn", "template": "Use the migrate-to-shoehorn skill. $ARGUMENTS" },
    "prototype": { "description": "Build throwaway prototype to answer design question", "template": "Use the prototype skill. $ARGUMENTS" },
    "research": { "description": "Investigate against primary sources, capture MD", "template": "Use the research skill. $ARGUMENTS" },
    "resolving-merge-conflicts": { "description": "Resolve in-progress git merge/rebase conflict", "template": "Use the resolving-merge-conflicts skill. $ARGUMENTS" },
    "scaffold-exercises": { "description": "Create exercise directory structures", "template": "Use the scaffold-exercises skill. $ARGUMENTS" },
    "setup-matt-pocock-skills": { "description": "Configure tracker, triage labels, domain docs", "template": "Use the setup-matt-pocock-skills skill. $ARGUMENTS" },
    "setup-pre-commit": { "description": "Set up Husky pre-commit with lint-staged", "template": "Use the setup-pre-commit skill. $ARGUMENTS" },
    "setup-ts-deep-modules": { "description": "Wire dependency-cruiser, deep module layout", "template": "Use the setup-ts-deep-modules skill. $ARGUMENTS" },
    "tdd": { "description": "Test-driven development red-green-refactor", "template": "Use the tdd skill. $ARGUMENTS" },
    "teach": { "description": "Teach me a skill or concept", "template": "Use the teach skill. $ARGUMENTS" },
    "to-questionnaire": { "description": "Turn undecidable decision into questionnaire", "template": "Use the to-questionnaire skill. $ARGUMENTS" },
    "to-spec": { "description": "Turn conversation into spec, publish to tracker", "template": "Use the to-spec skill. $ARGUMENTS" },
    "to-tickets": { "description": "Break plan into tracer-bullet tickets", "template": "Use the to-tickets skill. $ARGUMENTS" },
    "triage": { "description": "Move issues/PRs through triage state machine", "template": "Use the triage skill. $ARGUMENTS" },
    "wait-what": { "description": "Stop — last message didn't land, re-pitch it", "template": "Use the wait-what skill. $ARGUMENTS" },
    "wayfinder": { "description": "Plan huge work as map of decision tickets", "template": "Use the wayfinder skill. $ARGUMENTS" },
    "wizard": { "description": "Interactive bash wizard for human-only steps", "template": "Use the wizard skill. $ARGUMENTS" },
    "writing-beats": { "description": "Writing: assemble material into beats journey", "template": "Use the writing-beats skill. $ARGUMENTS" },
    "writing-for-agents": { "description": "Write docs for agents (skills, AGENTS.md)", "template": "Use the writing-for-agents skill. $ARGUMENTS" },
    "writing-fragments": { "description": "Writing: mine raw fragments, no structure", "template": "Use the writing-fragments skill. $ARGUMENTS" },
    "writing-shape": { "description": "Writing: shape raw material into article", "template": "Use the writing-shape skill. $ARGUMENTS" }
  }
}
